{
  "name": "tilt-card-react",
  "version": "0.1.0",
  "description": "3D parallax tilt for React — pointer tilt with glare and depth layers on desktop, gyroscope tilt on mobile. A tiny hook + card component, zero dependencies, React 18 & 19.",
  "keywords": [
    "react",
    "tilt",
    "parallax",
    "3d",
    "card",
    "hover",
    "glare",
    "gyroscope",
    "device-orientation",
    "perspective",
    "animation",
    "microinteraction",
    "react-hook",
    "reduced-motion",
    "ui",
    "zero-dependency"
  ],
  "author": "kea0811",
  "license": "MIT",
  "homepage": "https://github.com/kea0811/tilt-card-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kea0811/tilt-card-react.git"
  },
  "bugs": {
    "url": "https://github.com/kea0811/tilt-card-react/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "demo:dev": "pnpm -F demo dev",
    "demo:build": "pnpm -F demo build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.2",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.2.4",
    "vitest": "^2.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.1"
}
